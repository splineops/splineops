{
  "schema_version": 1,
  "description": "Machine-relative development benchmark thresholds; not release promises.",
  "checks": [
    {
      "name": "TensorSpline repeated-coordinate speedup",
      "artifact": "tensorspline-query-plan.json",
      "json_path": "speedup",
      "minimum": 1.1
    },
    {
      "name": "Affine numerical equivalence",
      "artifact": "affine.json",
      "json_path": "results.*.max_abs_difference",
      "maximum": 1e-10
    },
    {
      "name": "Differentials vectorization floor",
      "artifact": "differentials.json",
      "json_path": "vectorized_speedup",
      "minimum": 5.0
    },
    {
      "name": "Differentials scalar-oracle error",
      "artifact": "differentials.json",
      "json_path": "max_abs_difference",
      "maximum": 2e-6
    },
    {
      "name": "Multiscale whole-axis speedup floor",
      "artifact": "multiscale.json",
      "json_path": "results.*.speedup",
      "minimum": 1.05
    },
    {
      "name": "Consolidated workflow regression floor",
      "artifact": "workflows.json",
      "json_path": "results.*.speedup",
      "minimum": 0.5
    },
    {
      "name": "Batched affine orchestration speedup",
      "artifact": "workflows.json",
      "json_path": "speedups_by_workflow.affine_explicit_axes",
      "minimum": 1.0
    },
    {
      "name": "Batched differential orchestration speedup",
      "artifact": "workflows.json",
      "json_path": "speedups_by_workflow.differentials_explicit_axes",
      "minimum": 1.05
    },
    {
      "name": "Batched wavelet roundtrip regression floor",
      "artifact": "workflows.json",
      "json_path": "speedups_by_workflow.wavelet_roundtrip_explicit_axes",
      "minimum": 0.75
    },
    {
      "name": "Consolidated workflow equivalence",
      "artifact": "workflows.json",
      "json_path": "results.*.max_abs_difference",
      "maximum": 2e-4
    },
    {
      "name": "Explicit batch traced-memory scaling",
      "artifact": "batch-scaling.json",
      "json_path": "summary.max_normalized_peak_growth",
      "maximum": 1.5
    },
    {
      "name": "Explicit batch numerical equivalence",
      "artifact": "batch-scaling.json",
      "json_path": "summary.max_abs_difference",
      "maximum": 1e-12
    },
    {
      "name": "Downstream workflow numerical equivalence",
      "artifact": "downstream-workflows.json",
      "json_path": "summary.max_abs_difference",
      "maximum": 1e-12
    },
    {
      "name": "Affine phase-path numerical equivalence",
      "artifact": "affine-phases.json",
      "json_path": "results.*.max_abs_difference",
      "maximum": 1e-12
    }
  ]
}
